# ==============================================================================
# Enterprise Cognitive Hybrid RAG Platform - Environment Configuration Template
# ==============================================================================

# Application Gateway
ENVIRONMENT=production
LOG_LEVEL=INFO
APP_HOST=0.0.0.0
APP_PORT=8000
API_KEY=your-enterprise-gateway-api-key-here
CORS_ORIGINS=["*"]

# Semantic Cache Configuration (Redis Vector Engine)
REDIS_URL=redis://localhost:6379/0
REDIS_CACHE_ENABLED=true
SEMANTIC_CACHE_SIMILARITY_THRESHOLD=0.92
SEMANTIC_CACHE_TTL_SECONDS=86400

# Dense Vector Storage (Qdrant / Azure AI Search)
QDRANT_URL=http://localhost:6333
QDRANT_API_KEY=
QDRANT_COLLECTION_NAME=enterprise_knowledge_base
EMBEDDING_MODEL=text-embedding-3-large
EMBEDDING_DIMENSION=3072
DENSE_TOP_K=50

# Sparse Lexical Storage (BM25)
BM25_K1=1.5
BM25_B=0.75
SPARSE_TOP_K=50

# Reciprocal Rank Fusion (RRF)
RRF_K=60
FUSED_TOP_N=50

# Cross-Encoder Reranker
RERANKER_MODEL=BAAI/bge-reranker-large
RERANKER_TOP_K=5
RERANKER_DEVICE=cpu
RERANKER_BATCH_SIZE=32

# Generation & LLM Providers
# Options: ollama, openai, azure_openai, anthropic, vllm
DEFAULT_LLM_PROVIDER=ollama

# Local Ollama Provider (Runs 100% locally on your machine)
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=gemma4:e2b
OLLAMA_EMBEDDING_MODEL=nomic-embed-text
EMBEDDING_PROVIDER=auto

# Cloud Providers (Optional)
OPENAI_API_KEY=your-openai-api-key
OPENAI_MODEL=gpt-4o

# Azure OpenAI (if DEFAULT_LLM_PROVIDER=azure_openai)
AZURE_OPENAI_API_KEY=
AZURE_OPENAI_ENDPOINT=https://your-resource.openai.azure.com/
AZURE_OPENAI_DEPLOYMENT_NAME=gpt-4o
AZURE_OPENAI_API_VERSION=2024-02-15-preview

# Anthropic (if DEFAULT_LLM_PROVIDER=anthropic)
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-3-5-sonnet-20240620

# vLLM / Local OpenAI compatible (if DEFAULT_LLM_PROVIDER=vllm)
VLLM_BASE_URL=http://localhost:8000/v1
VLLM_MODEL=meta-llama/Meta-Llama-3-70B-Instruct

# Synthesis Parameters
TEMPERATURE=0.1
MAX_TOKENS=2048
STREAM_TIMEOUT_SECONDS=30

# Chunking Configuration
DEFAULT_CHUNK_SIZE_TOKENS=512
DEFAULT_CHUNK_OVERLAP_TOKENS=100
DEDUPLICATION_ENABLED=true

# Telemetry & Observability
PROMETHEUS_METRICS_ENABLED=true
OTEL_EXPORTER_OTLP_ENDPOINT=
